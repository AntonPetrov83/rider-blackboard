<idea-plugin>
    <id>com.blackboard</id>
    <name>Blackboard</name>
    <vendor>Blackboard</vendor>

    <description><![CDATA[
        Lightweight project-specific Markdown scratchpad for JetBrains Rider.
        Open, write, close, continue coding - notes are saved automatically per project.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <resource-bundle>messages.BlackboardBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Blackboard"
                    anchor="right"
                    secondary="false"
                    icon="AllIcons.Toolwindows.Documentation"
                    factoryClass="com.blackboard.ui.BlackboardToolWindowFactory"/>
        <notificationGroup id="Blackboard" displayType="BALLOON" key="notification.group.name"/>
    </extensions>
</idea-plugin>
