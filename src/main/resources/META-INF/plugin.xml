<idea-plugin>
    <id>io.github.antonpetrov83.blackboard</id>
    <name>Blackboard</name>
    <vendor url="https://github.com/AntonPetrov83/rider-blackboard">Anton Petrov</vendor>

    <description><![CDATA[
        Lightweight project-specific Markdown scratchpad for JetBrains Rider.
        Open, write, close, continue coding - notes are saved automatically per project.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <resource-bundle>messages.BlackboardBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Blackboard"
                    anchor="right"
                    secondary="false"
                    icon="AllIcons.Actions.ListFiles"
                    factoryClass="com.blackboard.ui.BlackboardToolWindowFactory"/>
        <notificationGroup id="Blackboard" displayType="BALLOON" key="notification.group.name"/>
    </extensions>

    <applicationListeners>
        <listener class="com.blackboard.services.BlackboardProjectCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <!-- Text and description come from action.Blackboard.Toggle.* in BlackboardBundle. -->
        <action id="Blackboard.Toggle"
                class="com.blackboard.actions.ToggleBlackboardAction"
                icon="AllIcons.Actions.ListFiles">
            <!-- Alt+B is free in $default and the Rider keymaps derived from it (Visual Studio, Visual Studio 2022,
                 ReSharper, Visual Assist, VSCode, Sublime Text). Emacs uses it for backward-word, so it is removed
                 there instead of silently overriding it. See README "Keyboard shortcut". -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt B"/>
            <keyboard-shortcut keymap="Emacs" first-keystroke="alt B" remove="true"/>
        </action>
    </actions>
</idea-plugin>
